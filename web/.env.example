# shiplog web — environment variables
#
# Copy this file to .env.local and fill in the values you need. .env.local is
# git-ignored; this template is committed. On Vercel, set the same names in the
# project's Environment Variables (Production).
#
# Only the "required" blocks are needed to sign in; each publishing platform and
# the builder-pods database are independent and optional.

# ─── Identity: GitHub sign-in — REQUIRED ─────────────────────────────────────
# Create a GitHub OAuth App (Settings → Developer settings → OAuth Apps).
# Register BOTH callback URLs on the app:
#   http://localhost:3000/api/github/callback
#   https://<your-domain>/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional — defaults to <origin>/api/github/callback. Set only to pin it.
# GITHUB_REDIRECT_URI=

# ─── Token encryption — REQUIRED for posting ─────────────────────────────────
# 64 hex characters (32 bytes); encrypts stored platform tokens (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENC_KEY=

# ─── Storage — REQUIRED when deployed ────────────────────────────────────────
# Connect a Vercel Blob store to the project: it sets BLOB_STORE_ID automatically
# and the SDK authenticates with OIDC. For CI or local Blob use a read-write
# token instead. With neither set, data is written to web/.data/ on local disk.
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=

# ─── AI drafts + post-edit grounding check — RECOMMENDED ─────────────────────
# Any OpenAI-compatible endpoint; the route appends /chat/completions.
# Without these, drafts fall back to a template and the grounding check is
# skipped (it never blocks posting).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ─── Builder pods — OPTIONAL ─────────────────────────────────────────────────
# Neon / Postgres connection string. Enables `shiplog pod` (builder profiles and
# pods); the schema is created on first use. Unset → pods are disabled and the
# rest of shiplog is unaffected.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── LinkedIn — OPTIONAL (to publish to LinkedIn) ────────────────────────────
# LinkedIn developer app with the "Sign In with LinkedIn using OpenID Connect"
# and "Share on LinkedIn" products approved (scopes: openid profile
# w_member_social). The redirect must match the app exactly.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/linkedin/callback
# Optional — LinkedIn-Version header; defaults to 202609.
# LINKEDIN_VERSION=202609

# ─── X / Twitter — OPTIONAL (to publish to X) ────────────────────────────────
# X app with OAuth 2.0 enabled, "Type of App" = Web App (confidential client),
# App permissions = Read and write. Register the callback URL exactly:
#   http://localhost:3000/api/x/callback   (and your production URL)
# NOTE: the variable is X_CLIENT_SECRET — not X_CLIENT_SECRET_KEY.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Optional — defaults to <origin>/api/x/callback. Set to pin an exact value.
# X_REDIRECT_URI=http://localhost:3000/api/x/callback

# ─── Farcaster via Neynar managed signers — OPTIONAL ─────────────────────────
# Neynar app API key (neynar.com).
FARCASTER_API_KEY=
# Seed phrase of your app's DEVELOPER Farcaster account — used server-side to
# sign the managed-signer key request. KEEP SECRET. Required to post to Farcaster.
FARCASTER_DEVELOPER_MNEMONIC=
# Optional — your app's developer FID; derived from the mnemonic if omitted.
# FARCASTER_DEVELOPER_FID=
# Optional — Neynar API base; defaults to https://api.neynar.com/v2.
# FARCASTER_API_BASE=
